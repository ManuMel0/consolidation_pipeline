{
  "datasets": [
    {
      "name": "f0aac180",
      "displayName": "vw_fact_orders_enriched",
      "config": {
        "version": "1.1",
        "source": "fmcg.gold.vw_fact_orders_enriched",
        "dimensions": [
          {
            "name": "date",
            "expr": "source.date",
            "displayName": "Date"
          },
          {
            "name": "product_code",
            "expr": "source.product_code",
            "displayName": "Product Code"
          },
          {
            "name": "customer_code",
            "expr": "source.customer_code",
            "displayName": "Customer Code"
          },
          {
            "name": "date_key",
            "expr": "source.date_key",
            "displayName": "Date Key"
          },
          {
            "name": "year",
            "expr": "source.year",
            "displayName": "Year"
          },
          {
            "name": "month_name",
            "expr": "source.month_name",
            "displayName": "Month Name"
          },
          {
            "name": "month_short_name",
            "expr": "source.month_short_name",
            "displayName": "Month Short Name"
          },
          {
            "name": "quarter",
            "expr": "source.quarter",
            "displayName": "Quarter"
          },
          {
            "name": "year_quarter",
            "expr": "source.year_quarter",
            "displayName": "Year Quarter"
          },
          {
            "name": "customer",
            "expr": "  CASE \r\n    WHEN customer IS NULL THEN 'Unknown'\r\n    ELSE customer \r\n  END AS customer",
            "displayName": "Customer"
          },
          {
            "name": "market",
            "expr": "  CASE \r\n    WHEN market IS NULL THEN 'Unknown'\r\n    ELSE market \r\n  END AS market",
            "displayName": "Market"
          },
          {
            "name": "platform",
            "expr": "  CASE \r\n    WHEN platform IS NULL THEN 'Unknown'\r\n    ELSE platform \r\n  END AS platform",
            "displayName": "Platform"
          },
          {
            "name": "channel",
            "expr": "  CASE \r\n    WHEN channel IS NULL THEN 'Unknown'\r\n    ELSE channel \r\n  END AS channel",
            "displayName": "Channel"
          },
          {
            "name": "division",
            "expr": "source.division",
            "displayName": "Division"
          },
          {
            "name": "category",
            "expr": "source.category",
            "displayName": "Category"
          },
          {
            "name": "product",
            "expr": "source.product",
            "displayName": "Product"
          },
          {
            "name": "variant",
            "expr": "source.variant",
            "displayName": "Variant"
          },
          {
            "name": "sold_quantity",
            "expr": "source.sold_quantity",
            "displayName": "Sold Quantity"
          },
          {
            "name": "price_inr",
            "expr": "source.price_inr",
            "displayName": "Price Inr"
          },
          {
            "name": "total_amount_inr",
            "expr": "source.total_amount_inr",
            "displayName": "Total Amount Inr"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(customer)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          },
          {
            "name": "total_revenue",
            "expr": "SUM(total_amount_inr)",
            "displayName": "Total Revenue (INR)"
          },
          {
            "name": "total_quantity",
            "expr": "SUM(sold_quantity)",
            "displayName": "Total Quantity Sold"
          },
          {
            "name": "avg_order_value",
            "expr": "MEASURE(total_revenue) / MEASURE(count)",
            "displayName": "Avg Order Value (INR)"
          }
        ]
      }
    }
  ],
